global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option forwardfor
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend www-http
    bind *:80
    redirect scheme https code 301 if !{ ssl_fc }
    default_backend web-backend

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/www.manzijabo.tech.pem
    http-request set-header X-Forwarded-Proto https
    default_backend web-backend

backend web-backend
    balance roundrobin
    server web-01 18.169.158.75:80 check
    server web-02 18.171.60.224:80 check
